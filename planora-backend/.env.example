# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/planora_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Security (Minimum 256 bits / 32 characters)
APP_JWT_SECRET=your-256-bit-secret-your-256-bit-secret-here
APP_JWT_EXPIRATION=86400000

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
